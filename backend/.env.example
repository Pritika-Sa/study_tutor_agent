JWT_SECRET_KEY=replace-with-a-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./app.db
MASTERY_THRESHOLD_PERCENT=60
REACT_MAX_ITERATIONS=3
ADAPTIVE_MAX_RETRIES=2

# RAG pipeline (Phase 3)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=../data/chroma
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.35

# LLM + web search (Phase 5/6) -- leave blank to run without them (RAG-only
# behavior); code paths that need them raise a clear error if missing.
GROQ_API_KEY=
# Verified working against a real Groq account (Sept 2026) -- confirm
# current availability for your own key with client.models.list().
GROQ_MODEL=openai/gpt-oss-120b
TAVILY_API_KEY=

# CORS (Phase 8) -- comma-separated origins allowed to call the API from a
# browser. The React dev server runs on 5173 by default (Vite).
CORS_ORIGINS=http://localhost:5173
